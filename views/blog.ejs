<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog</title>
</head>
<body>
    <h1>Welcome to the Blog</h1>
    <% posts.forEach(post => { %>
        <h2>Author: <%= post.author %></h2>
        <p><%= post.content %></p>
    <% }) %>
    <form action="/new-blog-post" method="post">
        <label for="new-post">New Post:</label>
        <textarea name="new-post" id=""></textarea>
        <button type="submit">Post!</button>
    </form>
</body>
</html>